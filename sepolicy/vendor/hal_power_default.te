allow hal_power_default sysfs_therm:file w_file_perms;
allow hal_power_default sysfs_touchpanel:dir r_dir_perms;
allow hal_power_default sysfs_touchpanel:file rw_file_perms;
allow hal_power_default fwk_stats_service:service_manager find;
allow hal_power_default hal_thermal_service:service_manager find;
hal_client_domain(hal_power_default, hal_thermal)

# To do powerhint on nodes defined in powerhint.json
allow hal_power_default vendor_sysfs_gpu:dir search;
allow hal_power_default vendor_sysfs_gpu:file rw_file_perms;

# Allow libperfmgr to control GPU boost
r_dir_file(hal_power_default, sysfs_ged)
allow hal_power_default sysfs_ged:file w_file_perms;

# Allow libperfmgr to access Transsion DT2W Nodes
allow hal_power_default proc_gesture_function:dir search;
allow hal_power_default proc_gesture_function:file rw_file_perms;