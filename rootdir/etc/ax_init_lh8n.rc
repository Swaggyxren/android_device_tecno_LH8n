on post-fs-data
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq


    chown system system /sys/class/devfreq/13000000.mali/governor
    chown system system /sys/class/devfreq/13000000.mali/min_freq
    chown system system /sys/class/devfreq/13000000.mali/max_freq
    chown system system /sys/class/devfreq/13000000.mali/cur_freq
    chown system system /sys/class/devfreq/13000000.mali/mali_busy
    chown system system /sys/kernel/ged/hal/gpu_utilization
    chown system system /sys/devices/platform/charger/tran_battery_cycle
    chown system system /sys/devices/platform/charger/battery_health_percent
    chmod 0664 /sys/class/devfreq/13000000.mali/governor
    chmod 0664 /sys/class/devfreq/13000000.mali/min_freq
    chmod 0664 /sys/class/devfreq/13000000.mali/max_freq
    chmod 0664 /sys/class/devfreq/13000000.mali/cur_freq
    chmod 0644 /sys/class/devfreq/13000000.mali/mali_busy
    chmod 0664 /sys/kernel/ged/hal/gpu_utilization
    chmod 0664 /sys/devices/platform/charger/tran_battery_cycle
    chmod 0664 /sys/devices/platform/charger/battery_health_percent

on boot
    setprop debug.renderengine.backend skiaglthreaded
    chown system system /sys/class/devfreq/13000000.mali/governor
    chown system system /sys/class/devfreq/13000000.mali/min_freq
    chown system system /sys/class/devfreq/13000000.mali/max_freq
    chown system system /sys/class/devfreq/13000000.mali/cur_freq
    chown system system /sys/class/devfreq/13000000.mali/mali_busy
    chown system system /sys/kernel/ged/hal/gpu_utilization
    chown system system /sys/devices/platform/charger/tran_battery_cycle
    chown system system /sys/devices/platform/charger/battery_health_percent
    chmod 0664 /sys/class/devfreq/13000000.mali/governor
    chmod 0664 /sys/class/devfreq/13000000.mali/min_freq
    chmod 0664 /sys/class/devfreq/13000000.mali/max_freq
    chmod 0664 /sys/class/devfreq/13000000.mali/cur_freq
    chmod 0644 /sys/class/devfreq/13000000.mali/mali_busy
    chmod 0664 /sys/kernel/ged/hal/gpu_utilization
    chmod 0664 /sys/devices/platform/charger/tran_battery_cycle
    chmod 0664 /sys/devices/platform/charger/battery_health_percent
    restorecon_recursive /sys/devices/platform/odm/odm:usb_switch/power_supply/usb_switch

on property:sys.boot_completed=1
    chown system system /sys/class/devfreq/13000000.mali/governor
    chown system system /sys/class/devfreq/13000000.mali/min_freq
    chown system system /sys/class/devfreq/13000000.mali/max_freq
    chown system system /sys/class/devfreq/13000000.mali/cur_freq
    chown system system /sys/class/devfreq/13000000.mali/mali_busy
    chown system system /sys/kernel/ged/hal/gpu_utilization
    chmod 0660 /sys/class/devfreq/13000000.mali/governor
    chmod 0660 /sys/class/devfreq/13000000.mali/min_freq
    chmod 0660 /sys/class/devfreq/13000000.mali/max_freq
    chmod 0660 /sys/class/devfreq/13000000.mali/cur_freq
    chmod 0640 /sys/class/devfreq/13000000.mali/mali_busy
    chmod 0664 /sys/kernel/ged/hal/gpu_utilization


