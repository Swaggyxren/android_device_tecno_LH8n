service vendor.health-lh8n /vendor/bin/hw/android.hardware.health-service.lh8n
    class hal
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w

service vendor.charger /vendor/bin/hw/android.hardware.health-service.lh8n --charger
    class charger
    seclabel u:r:charger_vendor:s0
    user system
    group system dbus
    capabilities SYS_BOOT WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
